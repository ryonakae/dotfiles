;; Agent Safehouse のローカルオーバーライド。
;; 生成ポリシーの後に読み込まれるため、ここでの deny/allow が最終的な優先権を持つ。
;; 通常の共有アクセスには --add-dirs-ro/--add-dirs を使い、ホスト固有のルールをここに書く。

;; HOMEの広い許可より後に、コピーされた秘密もファイル名で保護する。
;;
;; スコープの使い分け:
;;   .* (全パス)   — システムパスに同名ファイルが存在しないパターン
;;   HOME_DIR 限定 — /opt/homebrew/etc 等のシステム SSL 証明書と衝突するパターン
(deny file-read* file-write*
    ;; 環境変数 / 設定ファイル
    (regex #".*/\.env$")
    (regex #".*/\.env\.keys$")
    (regex #".*/\.env\.local$")
    (regex #".*/\.env\.development$")
    (regex #".*/\.env\.development\.local$")
    (regex #".*/\.env\.preview$")
    (regex #".*/\.env\.preview\.local$")
    (regex #".*/\.env\.staging$")
    (regex #".*/\.env\.staging\.local$")
    (regex #".*/\.env\.production$")
    (regex #".*/\.env\.production\.local$")
    (regex #".*/\.env\.test$")
    (regex #".*/\.env\.test\.local$")
    (regex #".*/\.envrc$")

    ;; クラウド / サービス認証情報
    (regex #".*/credentials\.json$")
    (regex #".*/service-account[^/]*\.json$")
    (regex #".*/[^/]*-credentials\.json$")
    (regex #".*/firebase-adminsdk[^/]*\.json$")

    ;; workdir/tmpにコピーされたSSH秘密鍵も対象にする。
    (regex #".*/id_rsa$")
    (regex #".*/id_ed25519$")
    (regex #".*/id_ecdsa$")
    (regex #".*/id_dsa$")

    ;; シークレットディレクトリ
    (regex #".*/secrets(/.*)?$")
    (regex #".*/\.secrets(/.*)?$")

    ;; 証明書 / キーストア（HOME_DIR 限定: システム SSL 証明書との衝突を回避）
    ;; certifi の CA バンドルは秘密鍵ではなく HTTPS 通信に必須なため除外
    (require-all
        (regex (string-append "^" HOME_DIR "/.*\\.pem$"))
        (require-not (regex #".*/certifi/cacert\.pem$"))
    )
    (regex (string-append "^" HOME_DIR "/.*\\.p8$"))
    (regex (string-append "^" HOME_DIR "/.*\\.p12$"))
    (regex (string-append "^" HOME_DIR "/.*\\.key$"))
    (regex (string-append "^" HOME_DIR "/.*\\.jks$"))
    (regex (string-append "^" HOME_DIR "/.*\\.keystore$"))
)

;; Gitは追跡用placeholderとdirectoryの列挙を必要とするが、秘密の内容は不要。
(allow file-read-metadata (regex #".*/\.secrets(/.*)?$"))
(allow file-read-data file-write-create
    (require-all
        (regex #".*/\.secrets$")
        (vnode-type DIRECTORY)
    )
)
(allow file-read* file-write* (regex #".*/\.secrets/\.gitkeep$"))

;; サードパーティ依存ディレクトリ配下に紛れる .env / 鍵 / pem は agent 個人の機密ではなく、
;; git clone / ビルドで読み書きが必要。上記の汎用 deny を後勝ち allow で例外化する。
;; これが無いと vendor/libghostty-vt/.envrc の checkout が deny されて clone が失敗する。
(allow file-read* file-write*
    (regex #".*/(vendor|node_modules|third_party)/.*/\.env[^/]*$")
    (regex #".*/(vendor|node_modules|third_party)/.*/\.envrc$")
    (regex #".*/(vendor|node_modules|third_party)/.*/id_(rsa|dsa|ecdsa|ed25519)$")
    (regex #".*/(vendor|node_modules|third_party)/.*\.pem$")
    (regex #".*/(vendor|node_modules|third_party)/.*\.p(8|12)$")
    (regex #".*/(vendor|node_modules|third_party)/.*\.(key|jks|keystore)$")
    ;; Cargo registry の test fixture (libnghttp2-sys 等)
    (regex (string-append "^" HOME_DIR "/\\.cargo/registry/.*\\.pem$"))
)

;; Flutter SDK / pub cache / analysis server / Android SDK manager の状態は同じワークフローで必要になる。
;; HOME以外へsymlinkされる場合も既存のSDKアクセスを維持する。
(allow file-read* file-write*
    (home-subpath "/.local/share/mise/installs/flutter")
    (home-subpath "/.pub-cache")
    (home-subpath "/.dart-tool")
    (home-subpath "/.dartServer")
    (home-subpath "/.android/cache")
    ;; 開発用の自動生成鍵だけを許可し、本番署名鍵は保護する。
    (home-literal "/.android/debug.keystore")
)

;; --enable=xcode の標準プロファイルは macOS 26 / Xcode 26 系の Simulator runtime に
;; 必要な mach service / fsctl をカバーしていないため、ここで補う。
;; これが無いと simctl が "liblaunch_sim.dylib could not be opened" /
;; "iOS-26-X Unavailable" で booted な Simulator を認識できない。
(allow mach-lookup
    (global-name "com.apple.CoreSimulator.simdiskimaged")
    (global-name "com.apple.CoreSimulator.SimLaunchHost-arm64")
)

;; DMG / cryptex マウントの読み書きで simctl が発行する fsctl ioctl。
(allow system-fsctl
    (fsctl-command (_IO "J" 32))
)

;; config.fish にマシンローカルの機密情報が含まれているため、
;; shell-init が有効化された場合でも読み書きを拒否する。
(deny file-read* file-write*
    (home-literal "/.config/fish/config.fish")
    (home-literal "/dotfiles/config/.config/fish/config.fish")
)

;; ホスト上の各種クレデンシャル。wide-read で / 全 read 開放しているため、
;; HOMEの後勝ち許可でも各credentialを再開放しない。
(deny file-read* file-write*
    (home-subpath "/.gnupg")
    (home-literal "/.aws/credentials")
    (home-literal "/.netrc")
    (home-literal "/.git-credentials")
    (home-literal "/.kube/config")
)

;; HOMEのlate grantがSSHの標準denyを上書きするため、例外ごと再適用する。
(deny file-read* file-write*
    (home-subpath "/.ssh")
    (home-subpath "/Library/Mail")
    (home-subpath "/Library/Messages")
    (home-subpath "/Library/Safari")
    (home-subpath "/Library/Containers/com.apple.mail")
    (home-subpath "/Library/Group Containers/group.com.apple.mail")
    (home-subpath "/Library/Application Support/Google/Chrome")
    (home-subpath "/Library/Application Support/Chromium")
    (home-subpath "/Library/Application Support/Firefox/Profiles")
    (home-subpath "/Library/Application Support/Microsoft Edge")
    (home-subpath "/Library/Application Support/BraveSoftware")
    (home-subpath "/Library/Application Support/Arc")
    (home-subpath "/Library/Application Support/Dia")
)
(allow file-read-metadata (home-literal "/.ssh") (home-literal "/.ssh/agent"))
(allow file-read*
    (home-literal "/.ssh/config")
    (home-subpath "/.ssh/config.d")
    (home-literal "/.ssh/known_hosts")
    (home-literal "/.ssh/allowed_signers")
)
(allow file-write*
    (home-literal "/.ssh/known_hosts")
    (home-literal "/.ssh/known_hosts.old")
)
(allow file-read* file-write* file-read-metadata (home-subpath "/.ssh/agent"))

;; 親のrenameで絶対パスの保護を外さず、配下の通常の書き込みは制限しない。
(deny file-write-unlink
    (literal HOME_DIR)
    (home-literal "/.config")
    (home-literal "/.config/fish")
    (home-literal "/.config/fish/functions")
    (home-literal "/.config/fish/conf.d")
    (home-literal "/.config/agent-safehouse")
    (home-literal "/.config/gomi")
    (home-literal "/.local")
    (home-literal "/.local/bin")
    (home-literal "/.local/share")
    (home-literal "/.aws")
    (home-literal "/.kube")
    (home-literal "/Library")
    (home-literal "/Library/Containers")
    (home-literal "/Library/Group Containers")
    (home-literal "/Library/Application Support")
    (home-literal "/Library/Application Support/Google")
    (home-literal "/Library/Application Support/Firefox")
    (home-literal "/dotfiles")
    (home-literal "/dotfiles/config")
    (home-literal "/dotfiles/config/.config")
    (home-literal "/dotfiles/config/.config/fish")
    (home-literal "/dotfiles/config/.config/fish/functions")
    (home-literal "/dotfiles/config/.config/fish/conf.d")
    (home-literal "/dotfiles/config/.config/agent-safehouse")
    (home-literal "/dotfiles/config/.config/gomi")
    (home-literal "/dotfiles/config/.local")
    (home-literal "/dotfiles/config/.local/bin")
)
;; 転送・注入の処理をsandbox内から書き換えて保護を無効化しない。
(deny file-write*
    (home-literal "/.local/bin/rm")
    (home-subpath "/.config/gomi")
    (home-subpath "/.config/agent-safehouse")
    (home-literal "/.config/fish/functions/__safehouse_args.fish")
    (home-literal "/.config/fish/functions/safe.fish")
    (home-literal "/.config/fish/functions/hermes.fish")
    (home-literal "/.config/fish/functions/rm.fish")
    (home-literal "/.config/fish/conf.d/gomi.fish")
    (home-literal "/dotfiles/config/.local/bin/rm")
    (home-subpath "/dotfiles/config/.config/gomi")
    (home-subpath "/dotfiles/config/.config/agent-safehouse")
    (home-literal "/dotfiles/config/.config/fish/functions/__safehouse_args.fish")
    (home-literal "/dotfiles/config/.config/fish/functions/safe.fish")
    (home-literal "/dotfiles/config/.config/fish/functions/hermes.fish")
    (home-literal "/dotfiles/config/.config/fish/functions/rm.fish")
    (home-literal "/dotfiles/config/.config/fish/conf.d/gomi.fish")
)

;; ~/.hermes は Hermes Agent の workdir かつ信頼境界。
;; Agent が自己改善で .env / hooks / cron / automations / skills を書き換える前提のため、
;; 上記の汎用 deny（.env / secrets / credentials.json 等）を後勝ちで貫通させる。
;; 信頼境界は ~/.hermes の内側に閉じる前提。
(allow file-read* file-write*
    (home-subpath "/.hermes")
)

;; terminal-notifier (macOS通知) が必要とする Mach サービスを許可。
;; macos-gui では hiservices 等は許可されるが、UserNotifications フレームワーク
;; が使う usernoted デーモンへの接続は含まれていないため、ここで補足する。
(allow mach-lookup
    (global-name "com.apple.usernoted.client")
    (global-name "com.apple.usernoted.daemon_client")
    (global-name "com.apple.usernotifications.usernotificationservice")
)

;; xcodebuild test は開始時に IOPMAssertionCreateWithName で sleep 抑止 assertion を取り、
;; powerd への mach-lookup が拒否されると -536870199 で Simulator test 自体が始まらない。
;; Safehouse の xcode integration は CoreSimulator だけを許可し powerd を含まないため、ここで補足する。
(allow mach-lookup
    (global-name "com.apple.PowerManagement.control")
    ;; test runner の DTServiceHub は Simulator へ接続する際に instruments の arbiter、security などの
    ;; XPC service を順に引く。1 つでも拒否されると "failed to bless service hub" で xcodebuild test が
    ;; 応答しなくなるため、Xcode 同梱の instruments service 群をまとめて許可する。
    (global-name-regex #"^com\.apple\.dt\.instruments\.")
)

;; xcodebuild test は完了後に Simulator 側で起動した test runner（sandbox 外のプロセス）へ終了シグナルを送る。
;; 既定の (allow signal (target same-sandbox)) では拒否され、終了を待ち続けてハングする。
;; --enable=process-control でも同じ許可が得られるが、wrapper の既存 --enable 一覧と併用すると
;; safehouse 0.9.0 の policy renderer が "Bad file descriptor" で落ちるため、ここで signal だけを開ける。
(allow signal (target others))

;; ホスト側のCuaDriverデーモンへの接続だけを許可する。
(allow network-outbound
    (home-literal "/Library/Caches/cua-driver/cua-driver.sock")
)

;; 元の保護パスから人間が移した秘密をtrash経由で読み取らせない。
;; renameによるPutは内容を読まず、metadataと書き込みは維持する。
(deny file-read-data file-write-data file-write-unlink
    (require-all
        (regex #".*/(Trash|\.Trash-[0-9]+|\.Trash/[0-9]+)/files(/.*)?$")
        (require-not (home-subpath "/.hermes"))
    )
    (home-subpath "/.Trash")
)

;; XDGの保存先が変わっても、ルートのrenameでpayloadのパス拒否を外さない。
(deny file-write-unlink
    (require-all
        (regex #".*/(Trash|\.Trash(-[0-9]+)?|\.Trash/[0-9]+)$")
        (require-not (home-subpath "/.hermes"))
    )
)
