;; HOME以外へsymlinkされたSDKも、既存の開発ワークフローで必要になる。
(allow file-read* file-write*
    (home-subpath "/.local/share/mise/installs/flutter")
    (home-subpath "/.pub-cache")
    (home-subpath "/.dart-tool")
    (home-subpath "/.dartServer")
    (home-subpath "/.android/cache")
)

;; Keep grants available even when these volumes are not mounted at startup.
(allow file-read* file-write*
    (subpath "/Volumes/External SSD")
    (subpath "/Volumes/Movies")
    (subpath "/Volumes/Downloads")
    (subpath "/Volumes/Pictures")
    (subpath "/Volumes/Other")
    (subpath "/Volumes/Books")
    (subpath "/Volumes/Design")
    (subpath "/Volumes/Documents")
    (subpath "/Volumes/Music")
)

;; 通常rmはmacos-trashへ転送し、絶対パス指定による直接削除を防ぐ。
(deny process-exec (literal "/bin/rm"))

;; 復旧先の内容を保護し、復元・掃除はユーザーがsandbox外で行う。
;; renameによる投入とmetadata処理は維持する。
(deny file-read-data file-write-data file-write-unlink
    (require-all
        (home-subpath "/.Trash")
        (require-not (home-literal "/.Trash"))
    )
)

;; Finderの「戻す」記録だけは書けるようにし、エージェントが消したファイルも元の場所へ戻せるようにする。
(allow file-read-data file-write-data
    (home-literal "/.Trash/.DS_Store")
)
