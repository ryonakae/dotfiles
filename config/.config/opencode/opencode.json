{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "cua": {
        "type": "local",
        "command": ["cua", "daemon", "mcp", "--permissions", "spaces:all"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      }
    }
  }
}
