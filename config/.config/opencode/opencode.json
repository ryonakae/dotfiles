{
  "$schema": "https://opencode.ai/config.json",
  "model": "strata/qwen3.8-flash-next-q2_0",
  "providers": {
    "strata": {
      "name": "Strata",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.8-flash-next-q2_0": {
          "name": "Qwen3.8 Flash Next Q2_0",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "splash": {
      "name": "Splash",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        "bonsai-2-27b-pq2_0": {
          "modelID": "prism-ml/Ternary-Bonsai-2-27B-gguf:PQ2_0",
          "name": "Bonsai 2 27B PQ2_0",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 2048
          }
        }
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "strata", "effect": "allow" },
    { "action": "provider.use", "resource": "splash", "effect": "allow" }
  ],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "cua": {
        "type": "local",
        "command": ["cua", "daemon", "mcp", "--permissions", "spaces:all"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      }
    }
  }
}
