set nocompatible
filetype plugin indent on
syntax on

set encoding=utf8
set fileencoding=utf-8
set number
set scrolloff=5
set hidden
set confirm
set wildmenu
set showcmd
set laststatus=2
set showmatch
set hlsearch
set ignorecase
set smartcase
set autoindent
set backspace=indent,eol,start
set shiftwidth=2
set softtabstop=2
set expandtab
set mouse=a
set clipboard=unnamedplus,unnamed
set noswapfile
set nowritebackup
set nobackup
