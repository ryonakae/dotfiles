<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ryonakae.cua-relay-keepalive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/USERNAME/.local/bin/cua-relay-keepalive</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/Library/Logs/cua-relay-keepalive.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/Library/Logs/cua-relay-keepalive.log</string>
</dict>
</plist>
