#!/usr/bin/env -S uv run --no-project --script
# /// script
# dependencies = []
# ///

import fcntl
import os
from pathlib import Path
import shutil
import signal
import stat
import subprocess
import sys


class Cancelled(Exception):
  def __init__(self, signum):
    self.signum = signum


interrupted = 0
active = False
child = None


def cancel(signum, frame):
  global interrupted
  interrupted = signum
  if child is not None:
    child.send_signal(signum)
  elif not active:
    raise Cancelled(signum)


def run_gomi(command, lock_fd):
  global active, child
  active = True
  try:
    # The child keeps the same flock alive even if this process is killed.
    child = subprocess.Popen(command, pass_fds=(lock_fd,))
    if interrupted:
      child.send_signal(interrupted)
    status = child.wait()
  finally:
    child = None
    active = False
  if interrupted:
    raise Cancelled(interrupted)
  return status


def parse_args(args):
  options = set()
  operands = []
  literal = False
  for arg in args:
    if literal:
      operands.append(arg)
    elif arg == '--':
      literal = True
    elif arg.startswith('-') and arg != '-':
      if arg.startswith('--') or any(flag not in 'frRvid' for flag in arg[1:]):
        raise ValueError(f'unsupported option: {arg}')
      for flag in arg[1:]:
        if flag == 'f':
          options.discard('i')
        elif flag == 'i':
          options.discard('f')
        options.add(flag)
    else:
      operands.append(arg)
  return options, operands


def main():
  for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
    signal.signal(signum, cancel)
  options, operands = parse_args(sys.argv[1:])
  if not operands:
    if 'f' in options:
      return 0
    raise ValueError('missing operand')
  if 'i' in options and not sys.stdin.isatty():
    raise ValueError('-i requires a terminal for confirmation')
  config = Path(os.environ['HOME']) / '.config/gomi/config.yaml'
  if not config.is_file() or not os.access(config, os.R_OK):
    raise ValueError(f'managed config missing or unreadable: {config}')
  gomi = shutil.which('gomi')
  if gomi is None:
    raise ValueError('gomi executable not found')
  lock_path = Path(os.environ['HOME']) / '.local/share/.rm-gomi.lock'
  lock_path.parent.mkdir(parents=True, exist_ok=True)
  fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
  with os.fdopen(fd, 'r+') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    return move_operands(options, operands, gomi, config, lock.fileno())


def check_protected_path(operand):
  home = Path(os.environ['HOME'])
  data = Path(os.environ.get('XDG_DATA_HOME') or home / '.local/share')
  roots = [home / '.local/share/Trash', data / 'Trash', home / '.trash',
           home / '.gomi', Path('/tmp/Trash'), Path('/var/tmp/Trash'),
           home / '.local/share/.rm-gomi.lock']
  target = Path(os.path.abspath(operand))
  # Resolve the parent, not the final symlink: rm targets the link itself.
  targets = {target, target.parent.resolve() / target.name}
  for form in targets:
    for ancestor in (form, *form.parents):
      if ancestor.name in ('.Trash', f'.Trash-{os.getuid()}'):
        roots.append(ancestor)
      for external in (ancestor / '.Trash' / str(os.getuid()),
                       ancestor / f'.Trash-{os.getuid()}'):
        if external.is_dir():
          roots.append(external)
  for root in roots:
    for protected in (Path(os.path.abspath(root)), root.resolve()):
      for form in targets:
        if form == protected or form in protected.parents or protected in form.parents:
          raise ValueError('refusing to move protected trash/lock path or its ancestor')


def move_operands(options, operands, gomi, config, lock_fd):
  result = 0
  for operand in operands:
    try:
      try:
        mode = os.lstat(operand).st_mode
      except FileNotFoundError:
        if 'f' in options:
          continue
        raise
      check_protected_path(operand)
      if stat.S_ISDIR(mode) and not options.intersection('rR'):
        if 'd' not in options:
          raise ValueError('is a directory (use -r, -R or -d)')
        with os.scandir(operand) as entries:
          if next(entries, None) is not None:
            raise ValueError('directory not empty')
      if 'i' in options:
        print(f'rm: move entire target {operand!r} to trash? [y/N] ',
              end='', file=sys.stderr, flush=True)
        answer = sys.stdin.readline()
        if not answer:
          raise ValueError('confirmation unavailable')
        if answer.strip().lower() not in ('y', 'yes'):
          continue
      status = run_gomi([gomi, '--config', str(config), '--', operand], lock_fd)
      if status:
        raise ValueError(f'gomi failed (exit {status})')
      if 'v' in options:
        print(f'moved to trash: {operand}')
    except (OSError, ValueError) as error:
      print(f'rm: {operand!r}: {error}', file=sys.stderr)
      result = 1
  return result


if __name__ == '__main__':
  try:
    sys.exit(main())
  except Cancelled as error:
    print(f'rm: cancelled by signal {error.signum}', file=sys.stderr)
    sys.exit(128 + error.signum)
  except (ValueError, OSError) as error:
    print(f'rm: {error}', file=sys.stderr)
    sys.exit(1)
