#!/bin/bash
set -euo pipefail

target="gui/$(/usr/bin/id -u)/ai.hermes.gateway"
# Native stop probes user/<UID> and managername when the GUI job is absent.
# Keep its graceful PID shutdown, but never let that heuristic mutate another domain.
case "$#:${1:-}" in
  1:managername)
    printf 'Aqua\n'
    ;;
  2:print)
    [[ "$2" == "$target" ]] || exit 113
    exec /bin/launchctl print "$target"
    ;;
  2:bootout)
    [[ "$2" == "$target" ]] || { printf 'Hermes: refusing non-GUI gateway target.\n' >&2; exit 1; }
    if /bin/launchctl print "$target" >/dev/null; then
      exec /bin/launchctl bootout "$target"
    else
      status=$?
      [[ "$status" == 113 ]] || exit "$status"
    fi
    ;;
  *)
    printf 'Hermes: unsupported native launchctl request.\n' >&2
    exit 1
    ;;
esac
